# Container deployment
FILIUS_IMAGE=ghcr.io/OWNER/filius-app-website
FILIUS_IMAGE_TAG=main
NPM_NETWORK=npm_default

# Optional self-hosted Umami analytics. The consent banner appears only when
# both the script URL and website ID are configured.
PUBLIC_UMAMI_SCRIPT_URL=https://analytics.filius.app/script.js
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_DOMAINS=filius.app,www.filius.app

# Legal publisher details. Keep PUBLIC_LEGAL_REVIEWED=false until a legal review
# confirms that the values and the deployed infrastructure match the notices.
PUBLIC_LEGAL_REVIEWED=false
PUBLIC_LEGAL_CONTROLLER_NAME=Sören Schröder
PUBLIC_LEGAL_CONTROLLER_ADDRESS=Max-Brauer-Allee 167f, 22765 Hamburg, Deutschland
PUBLIC_LEGAL_CONTROLLER_EMAIL=support@filius.app
PUBLIC_LEGAL_CONTROLLER_PHONE=
PUBLIC_LEGAL_VAT_ID=
PUBLIC_LEGAL_REGISTER_ENTRY=

# Hosting and processing details
PUBLIC_HOSTING_PROVIDER_NAME=Oracle Cloud Infrastructure (Oracle Deutschland B.V. & Co. KG)
PUBLIC_HOSTING_PROVIDER_ADDRESS=Riesstraße 25, 80992 München
PUBLIC_HOSTING_COUNTRY=Germany
# Oracle Frankfurt region confirmed for this deployment.
PUBLIC_HOSTING_REGION=eu-frankfurt-1
PUBLIC_CLOUDFLARE_PROXY_ENABLED=true
# Nginx Proxy Manager defaults: current week plus four access-log archives and
# current week plus ten error-log archives.
PUBLIC_ACCESS_LOG_RETENTION_DAYS=35
PUBLIC_ERROR_LOG_RETENTION_DAYS=77
# Cloudflare Email Routing forwards support mail to a consumer Gmail mailbox.
# Change the mode to google-workspace if the destination is a Workspace account.
PUBLIC_EMAIL_PROVIDER_NAME=Google Ireland Limited
PUBLIC_EMAIL_PROVIDER_ADDRESS=Gordon House, Barrow Street, Dublin 4
PUBLIC_EMAIL_PROVIDER_COUNTRY=Ireland
PUBLIC_EMAIL_PROVIDER_MODE=consumer-gmail
PUBLIC_ANALYTICS_RETENTION_DAYS=180
PUBLIC_PRIVACY_NOTICE_DATE=29 July 2026
