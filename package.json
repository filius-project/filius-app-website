{
  "name": "filius-app-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:contact && npm run test:browser",
    "test:browser": "playwright test",
    "test:contact": "npm --prefix contact test",
    "test:contact:compose": "bash scripts/test-smtp-compose-secret.sh",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:secrets": "node scripts/verify-public-secret-boundary.mjs",
    "validate": "npm run format:check && npm run validate:secrets && npm run validate:content && npm run check && npm run build",
    "build:learning": "node scripts/build-filiuspad-learning-materials.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/starlight": "^0.41.6",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "astro": "^7.1.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
