---
import BaseLayout from "../layouts/BaseLayout.astro";
import PrivacyPage from "../components/PrivacyPage.astro";
import { privacyNoticeReady } from "../config";
const locale = "de" as const;
const title = "Datenschutzerklärung";
const description =
  "Datenschutzinformationen für filius.app, optionale Reichweitenmessung, Kontaktformular und Support.";
---

<BaseLayout
  locale={locale}
  title={`${title} – Filius on iPad`}
  description={description}
  noindex={!privacyNoticeReady}
>
  <PrivacyPage locale={locale} />
</BaseLayout>
