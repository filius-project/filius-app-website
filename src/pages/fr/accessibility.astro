---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustPage from '../../components/TrustPage.astro';
import { copy } from '../../lib/content';
const locale = 'fr' as const;
const c = copy[locale];
---
<BaseLayout locale={locale} title={`${c.accessibility.title} – Filius on iPad`} description={c.accessibility.intro} noindex>
  <TrustPage locale={locale} kind="accessibility" />
</BaseLayout>
