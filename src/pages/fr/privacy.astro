---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PrivacyPage from "../../components/PrivacyPage.astro";
import { privacyNoticeReady } from "../../config";
const locale = "fr" as const;
const title = "Politique de confidentialité";
const description =
  "Informations sur la confidentialité, la mesure d’audience facultative, le formulaire de contact et l’assistance.";
---

<BaseLayout
  locale={locale}
  title={`${title} – Filius on iPad`}
  description={description}
  noindex={!privacyNoticeReady}
>
  <PrivacyPage locale={locale} />
</BaseLayout>
