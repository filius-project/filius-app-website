---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImprintPage from '../../components/ImprintPage.astro';
import { legalNoticeReady } from '../../config';
const locale = 'fr' as const;
const title = 'Mentions légales';
const description = 'Identification de l’éditeur et coordonnées de filius.app.';
---
<BaseLayout locale={locale} title={`${title} – Filius on iPad`} description={description} noindex={!legalNoticeReady}>
  <ImprintPage locale={locale} />
</BaseLayout>
