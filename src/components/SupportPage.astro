---
import type { Locale } from "../config";
import { localizedPath, site } from "../config";
import { copy } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const subject = encodeURIComponent("Filius on iPad support request");
const body = encodeURIComponent(
  "Filius on iPad version:\niPadOS version:\niPad model:\n\nSteps to reproduce:\n1. \n2. \n\nExpected result:\n\nActual result:\n",
);
const privacyPath = localizedPath(locale, "privacy");
const formCopy = {
  de: {
    eyebrow: "Kontaktformular",
    title: "Direkt aus dem Browser schreiben",
    intro:
      "Das Formular übermittelt nur die Angaben, die zur Beantwortung nötig sind. Es speichert nichts im Browser und akzeptiert keine Anhänge.",
    name: "Name (optional)",
    email: "E-Mail-Adresse",
    category: "Thema",
    categories: {
      support: "Technisches Problem",
      feedback: "Feedback oder Idee",
      accessibility: "Barriere melden",
      privacy: "Datenschutzanfrage",
      other: "Sonstiges",
    },
    message: "Nachricht",
    messageHint: "Mindestens 20, höchstens 4.000 Zeichen.",
    remaining: "Noch {count} Zeichen",
    details: "Technische Angaben ergänzen (optional)",
    appVersion: "Filius on iPad-Version",
    device: "iPadOS-Version und iPad-Modell",
    privacyPrefix:
      "Die Nachricht wird über den eigenen Kontakt-Dienst an das Support-Postfach übermittelt. Einzelheiten stehen in der",
    privacyLink: "Datenschutzerklärung",
    privacySuffix:
      ". Bitte keine sensiblen Projektdateien oder Screenshots mitsenden; Anhänge werden nur nach Rückfrage per E-Mail angenommen.",
    submit: "Nachricht senden",
    sending: "Nachricht wird gesendet …",
    success: "Danke. Deine Nachricht wurde an den Support gesendet.",
    error:
      "Die Nachricht konnte gerade nicht gesendet werden. Bitte versuche es erneut oder nutze die Support-E-Mail.",
    noScript:
      "Ohne JavaScript wird nach dem Absenden eine schlichte Bestätigungsseite angezeigt.",
  },
  en: {
    eyebrow: "Contact form",
    title: "Write directly from your browser",
    intro:
      "The form sends only the details needed to answer your request. It stores nothing in your browser and does not accept attachments.",
    name: "Name (optional)",
    email: "Email address",
    category: "Topic",
    categories: {
      support: "Technical problem",
      feedback: "Feedback or idea",
      accessibility: "Report an accessibility barrier",
      privacy: "Privacy request",
      other: "Other",
    },
    message: "Message",
    messageHint: "Between 20 and 4,000 characters.",
    remaining: "{count} characters remaining",
    details: "Add technical details (optional)",
    appVersion: "Filius on iPad version",
    device: "iPadOS version and iPad model",
    privacyPrefix:
      "The message is relayed by the first-party contact service to the support mailbox. Details are provided in the",
    privacyLink: "privacy notice",
    privacySuffix:
      ". Do not send sensitive project files or screenshots; attachments are accepted by email only after request.",
    submit: "Send message",
    sending: "Sending message …",
    success: "Thank you. Your message was sent to support.",
    error:
      "The message could not be sent right now. Please try again or use the support email address.",
    noScript:
      "Without JavaScript, a simple confirmation page is shown after submission.",
  },
  fr: {
    eyebrow: "Formulaire de contact",
    title: "Écrire directement depuis le navigateur",
    intro:
      "Le formulaire transmet uniquement les informations nécessaires à la réponse. Il ne stocke rien dans le navigateur et n’accepte aucune pièce jointe.",
    name: "Nom (facultatif)",
    email: "Adresse e-mail",
    category: "Sujet",
    categories: {
      support: "Problème technique",
      feedback: "Avis ou idée",
      accessibility: "Signaler un obstacle d’accessibilité",
      privacy: "Demande relative aux données",
      other: "Autre",
    },
    message: "Message",
    messageHint: "Entre 20 et 4 000 caractères.",
    remaining: "Encore {count} caractères",
    details: "Ajouter des informations techniques (facultatif)",
    appVersion: "Version de Filius on iPad",
    device: "Version d’iPadOS et modèle d’iPad",
    privacyPrefix:
      "Le service de contact interne transmet le message à la boîte d’assistance. Les détails figurent dans la",
    privacyLink: "politique de confidentialité",
    privacySuffix:
      ". N’envoyez aucun fichier de projet ni capture sensible ; les pièces jointes ne sont acceptées par e-mail qu’après demande.",
    submit: "Envoyer le message",
    sending: "Envoi du message …",
    success: "Merci. Votre message a été envoyé à l’assistance.",
    error:
      "Le message ne peut pas être envoyé pour le moment. Réessayez ou utilisez l’adresse e-mail d’assistance.",
    noScript:
      "Sans JavaScript, une page de confirmation simple s’affiche après l’envoi.",
  },
}[locale];
---

<section class="page-hero support-hero">
  <div class="shell">
    <p class="eyebrow">{c.nav.support}</p>
    <h1>{c.support.title}</h1>
    <p class="lede">{c.support.intro}</p>
  </div>
</section>

<section class="section support-section">
  <div class="shell support-grid">
    <article class="email-card">
      <div class="mail-icon" aria-hidden="true">@</div>
      <p class="eyebrow">{c.support.emailTitle}</p>
      <h2>{site.supportEmail}</h2>
      <p>{c.support.emailBody}</p>
      <a
        class="button button--primary"
        href={`mailto:${site.supportEmail}?subject=${subject}&body=${body}`}
        data-umami-event="support-email-open"
      >
        {c.common.supportEmail}
      </a>
    </article>
    <article class="checklist-card">
      <p class="eyebrow">{c.support.checklistTitle}</p>
      <ol>
        {c.support.checklist.map((item) => <li>{item}</li>)}
      </ol>
    </article>
  </div>
</section>

<section class="section contact-section" id="contact-form">
  <div class="shell contact-layout">
    <div class="contact-intro">
      <p class="eyebrow">{formCopy.eyebrow}</p>
      <h2>{formCopy.title}</h2>
      <p>{formCopy.intro}</p>
      <div class="contact-route" aria-hidden="true">
        <span>filius.app</span><i></i><span>{site.supportEmail}</span>
      </div>
    </div>

    <form
      class="contact-form"
      action="/api/contact"
      method="post"
      enctype="application/x-www-form-urlencoded"
      accept-charset="UTF-8"
      data-contact-form
      data-sending={formCopy.sending}
      data-success={formCopy.success}
      data-error={formCopy.error}
    >
      <input type="hidden" name="locale" value={locale} />

      <div class="contact-trap" hidden>
        <label for={`contact-company-${locale}`}>Company</label>
        <input
          id={`contact-company-${locale}`}
          name="company"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="field">
        <label for={`contact-name-${locale}`}>{formCopy.name}</label>
        <input
          id={`contact-name-${locale}`}
          name="name"
          type="text"
          maxlength="100"
          autocomplete="name"
        />
      </div>

      <div class="field">
        <label for={`contact-email-${locale}`}>{formCopy.email}</label>
        <input
          id={`contact-email-${locale}`}
          name="email"
          type="email"
          maxlength="254"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="field field--full">
        <label for={`contact-category-${locale}`}>{formCopy.category}</label>
        <select id={`contact-category-${locale}`} name="category" required>
          {
            Object.entries(formCopy.categories).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))
          }
        </select>
      </div>

      <div class="field field--full">
        <label for={`contact-message-${locale}`}>{formCopy.message}</label>
        <textarea
          id={`contact-message-${locale}`}
          name="message"
          rows="9"
          minlength="20"
          maxlength="4000"
          aria-describedby={`contact-message-hint-${locale}`}
          required
          data-contact-message></textarea>
        <div class="field-meta" id={`contact-message-hint-${locale}`}>
          <span>{formCopy.messageHint}</span>
          <span data-character-count data-template={formCopy.remaining}></span>
        </div>
      </div>

      <details class="technical-fields field--full">
        <summary>{formCopy.details}</summary>
        <div class="technical-grid">
          <div class="field">
            <label for={`contact-app-version-${locale}`}
              >{formCopy.appVersion}</label
            >
            <input
              id={`contact-app-version-${locale}`}
              name="appVersion"
              type="text"
              maxlength="100"
              autocomplete="off"
            />
          </div>
          <div class="field">
            <label for={`contact-device-${locale}`}>{formCopy.device}</label>
            <input
              id={`contact-device-${locale}`}
              name="device"
              type="text"
              maxlength="160"
              autocomplete="off"
            />
          </div>
        </div>
      </details>

      <p class="privacy-note field--full">
        {formCopy.privacyPrefix}
        <a href={privacyPath}>{formCopy.privacyLink}</a>{formCopy.privacySuffix}
      </p>

      <div class="form-actions field--full">
        <button class="button button--primary" type="submit" data-submit-button>
          {formCopy.submit}
        </button>
        <p
          class="form-status"
          role="status"
          aria-live="polite"
          data-form-status
        >
        </p>
      </div>

      <noscript
        ><p class="no-script field--full">{formCopy.noScript}</p></noscript
      >
    </form>
  </div>
</section>

<script>
  const contactForms = document.querySelectorAll("[data-contact-form]");

  for (const form of contactForms) {
    if (!(form instanceof HTMLFormElement)) continue;

    const message = form.querySelector("[data-contact-message]");
    const characterCount = form.querySelector("[data-character-count]");
    const submitButton = form.querySelector("[data-submit-button]");
    const status = form.querySelector("[data-form-status]");

    const updateCharacterCount = () => {
      if (
        !(message instanceof HTMLTextAreaElement) ||
        !(characterCount instanceof HTMLElement)
      ) {
        return;
      }
      const template = characterCount.dataset.template ?? "{count}";
      characterCount.textContent = template.replace(
        "{count}",
        String(message.maxLength - message.value.length),
      );
    };

    updateCharacterCount();
    message?.addEventListener("input", updateCharacterCount);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (
        !(submitButton instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submitButton.disabled = true;
      form.setAttribute("aria-busy", "true");
      status.dataset.state = "pending";
      status.setAttribute("role", "status");
      status.textContent = form.dataset.sending ?? "";

      const body = new URLSearchParams();
      for (const [key, value] of new FormData(form).entries()) {
        if (typeof value === "string") body.append(key, value);
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          },
          body,
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));

        if (!response.ok || payload.ok !== true) {
          throw new Error(
            typeof payload.message === "string"
              ? payload.message
              : form.dataset.error,
          );
        }

        form.reset();
        updateCharacterCount();
        status.dataset.state = "success";
        status.textContent =
          typeof payload.message === "string"
            ? payload.message
            : (form.dataset.success ?? "");
      } catch (error) {
        status.dataset.state = "error";
        status.setAttribute("role", "alert");
        status.textContent =
          error instanceof Error && error.message
            ? error.message
            : (form.dataset.error ?? "");
      } finally {
        submitButton.disabled = false;
        form.removeAttribute("aria-busy");
      }
    });
  }
</script>

<style>
  .support-hero {
    color: white;
    background: var(--navy-950);
  }
  .support-hero .eyebrow {
    color: #ff8991;
  }
  .support-hero .lede {
    color: rgb(255 255 255 / 0.65);
  }
  .support-section {
    background: var(--canvas);
  }
  .support-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1rem;
  }
  .email-card,
  .checklist-card {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
  }
  .email-card {
    color: white;
    background: var(--navy-900);
    box-shadow: var(--shadow-soft);
  }
  .email-card .eyebrow {
    color: #ff8991;
  }
  .email-card h2 {
    overflow-wrap: anywhere;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }
  .email-card p:not(.eyebrow) {
    color: rgb(255 255 255 / 0.66);
  }
  .mail-icon {
    width: 4.6rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 2rem;
    border-radius: 1.25rem;
    color: white;
    background: var(--red-500);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 850;
  }
  .checklist-card {
    border: 1px solid var(--line);
    background: var(--paper-strong);
  }
  .checklist-card ol {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: items;
  }
  .checklist-card li {
    counter-increment: items;
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.8rem;
    align-items: center;
  }
  .checklist-card li::before {
    content: counter(items);
    width: 2.4rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 0.7rem;
    color: white;
    background: var(--navy-900);
    font-weight: 850;
  }

  .contact-section {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 12% 18%,
        rgb(212 48 58 / 0.13),
        transparent 24rem
      ),
      var(--paper);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }
  .contact-intro {
    position: sticky;
    top: 7rem;
  }
  .contact-intro h2 {
    max-width: 10ch;
    font-size: clamp(2.5rem, 5vw, 4.7rem);
  }
  .contact-intro > p:not(.eyebrow) {
    max-width: 32rem;
    color: #4b5260;
    font-size: 1.08rem;
  }
  .contact-route {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    color: var(--navy-700);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 760;
  }
  .contact-route i {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--red-500);
  }
  .contact-route i::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-top: 2px solid var(--red-500);
    border-right: 2px solid var(--red-500);
    transform: translateY(-50%) rotate(45deg);
  }
  .contact-form {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    padding: clamp(1.3rem, 4vw, 2.7rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--paper-strong);
    box-shadow: var(--shadow-card);
  }
  .field {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field label {
    color: var(--navy-900);
    font-size: 0.92rem;
    font-weight: 780;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid #b9bec8;
    border-radius: 0.85rem;
    background: #fff;
    color: var(--navy-950);
    font: inherit;
  }
  .field input,
  .field select {
    min-height: 3.25rem;
    padding: 0.7rem 0.85rem;
  }
  .field textarea {
    min-height: 13rem;
    resize: vertical;
    padding: 0.85rem;
    line-height: 1.55;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible,
  .technical-fields summary:focus-visible {
    outline: 3px solid rgb(212 48 58 / 0.32);
    outline-offset: 2px;
    border-color: var(--red-500);
  }
  .field-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #656c78;
    font-size: 0.82rem;
  }
  .technical-fields {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 0.9rem;
  }
  .technical-fields summary {
    width: fit-content;
    cursor: pointer;
    color: var(--navy-900);
    font-weight: 780;
  }
  .technical-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    padding-top: 1rem;
  }
  .privacy-note,
  .no-script {
    margin: 0;
    color: #5b626e;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .privacy-note a {
    color: var(--red-600);
    font-weight: 750;
  }
  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-actions .button {
    border: 0;
    cursor: pointer;
  }
  .form-actions .button:disabled {
    cursor: wait;
    opacity: 0.62;
    transform: none;
  }
  .form-status {
    flex: 1;
    min-width: min(100%, 16rem);
    margin: 0;
    color: #4c5360;
    font-weight: 700;
  }
  .form-status:empty {
    display: none;
  }
  .form-status[data-state="success"] {
    color: #14633d;
  }
  .form-status[data-state="error"] {
    color: #a51f2a;
  }
  @media (max-width: 52rem) {
    .support-grid,
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .contact-intro {
      position: static;
    }
    .contact-intro h2 {
      max-width: 14ch;
    }
  }
  @media (max-width: 38rem) {
    .contact-form,
    .technical-grid {
      grid-template-columns: 1fr;
    }
    .field {
      grid-column: 1;
    }
    .field-meta,
    .form-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
