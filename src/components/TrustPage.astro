---
import type { Locale } from '../config';
import { copy } from '../lib/content';
type Kind = 'privacy' | 'imprint' | 'accessibility' | 'licenses';
interface Props { locale: Locale; kind: Kind }
const { locale, kind } = Astro.props;
const c = copy[locale];
const content = c[kind];
const sections = 'sections' in content ? content.sections : [{ title: content.title, body: content.body }];
---
<section class="page-hero trust-hero"><div class="reading"><p class="eyebrow">Trust & legal</p><h1>{content.title}</h1><p class="lede">{content.intro}</p><p class="draft-notice">{c.common.legalDraft}</p></div></section>
<section class="section trust-section"><div class="reading prose content-card">{sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</div></section>
<style>
  .trust-hero { background: var(--paper); }
  .trust-section { padding-top: 0; background: var(--paper); }
  .prose section:first-child h2 { margin-top: 0; }
</style>
