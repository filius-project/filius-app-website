---
import type { Locale } from '../config';
import { copy } from '../lib/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale].features;
---
<div class="network-lab">
  <svg viewBox="0 0 1000 650" aria-hidden="true" preserveAspectRatio="none">
    <path d="M500 320 C360 320 300 160 165 155 M500 320 C650 310 710 150 840 150 M500 320 C360 345 285 510 160 505 M500 320 C650 350 735 510 850 505 M500 320 L500 75 M500 320 L500 575" />
  </svg>
  <div class="core"><span>F</span><strong>Filius on iPad</strong><small>Network Lab</small></div>
  {c.nodes.map((node, index) => <article class={`lab-node node-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span><h3>{node.title}</h3><p>{node.body}</p></article>)}
</div>
<style>
  .network-lab { position: relative; min-height: 42rem; margin-top: 3.5rem; border: 1px solid rgb(255 255 255 / .13); border-radius: var(--radius-xl); background: radial-gradient(circle at 50% 48%, rgb(244 22 36 / .14), transparent 21%), linear-gradient(145deg, #11182f, #202b51); overflow: hidden; box-shadow: 0 30px 80px rgb(16 23 47 / .25); }
  svg { position: absolute; inset: 4rem 3rem; width: calc(100% - 6rem); height: calc(100% - 8rem); }
  path { fill: none; stroke: rgb(255 255 255 / .22); stroke-width: 2; stroke-dasharray: 5 8; vector-effect: non-scaling-stroke; }
  .core { position: absolute; left: 50%; top: 50%; width: 10rem; aspect-ratio: 1; transform: translate(-50%, -50%); display: grid; place-items: center; align-content: center; border: 1px solid rgb(255 255 255 / .2); border-radius: 2.5rem; color: white; background: rgb(16 23 47 / .88); box-shadow: 0 0 0 1.1rem rgb(255 255 255 / .035), 0 20px 50px rgb(0 0 0 / .3); }
  .core span { width: 3.2rem; aspect-ratio: 1; display: grid; place-items: center; border-radius: .9rem; color: white; background: var(--red-500); font-family: var(--font-display); font-size: 1.8rem; font-weight: 850; }
  .core strong { margin-top: .5rem; font-family: var(--font-display); font-size: 1.1rem; }
  .core small { color: rgb(255 255 255 / .55); }
  .lab-node { position: absolute; width: min(14rem, 24%); min-height: 8.2rem; padding: 1rem; border: 1px solid rgb(255 255 255 / .16); border-radius: 1.25rem; color: white; background: rgb(255 255 255 / .075); backdrop-filter: blur(10px); }
  .lab-node > span { color: var(--red-400); font-size: .7rem; font-weight: 850; letter-spacing: .12em; }
  .lab-node h3 { margin-top: .35rem; font-size: 1.25rem; letter-spacing: -.02em; }
  .lab-node p { margin: .35rem 0 0; color: rgb(255 255 255 / .62); font-size: .94rem; line-height: 1.35; }
  .node-1 { left: 5%; top: 8%; } .node-2 { right: 5%; top: 8%; } .node-3 { left: 5%; bottom: 8%; } .node-4 { right: 5%; bottom: 8%; } .node-5 { left: 38%; top: 3%; } .node-6 { left: 38%; bottom: 3%; }
  @media (max-width: 48rem) {
    .network-lab { min-height: auto; display: grid; grid-template-columns: 1fr; gap: .75rem; padding: 1rem; }
    svg { display: none; }
    .core, .lab-node { position: static; width: auto; min-height: auto; transform: none; }
    .core { aspect-ratio: auto; min-height: 10rem; }
  }
</style>
