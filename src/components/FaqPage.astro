---
import type { Locale } from '../config';
import { localizedPath } from '../config';
import { copy } from '../lib/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<section class="page-hero faq-hero"><div class="shell"><p class="eyebrow">FAQ</p><h1>{c.faq.title}</h1><p class="lede">{c.faq.intro}</p></div></section>
<section class="section faq-section"><div class="reading faq-list">{c.faq.items.map((item, index) => <details><summary><span>{String(index + 1).padStart(2,'0')}</span>{item.question}<i aria-hidden="true">+</i></summary><div><p>{item.answer}</p></div></details>)}</div></section>
<section class="section--compact faq-cta"><div class="reading content-card"><h2>{c.support.emailTitle}</h2><p>{c.support.emailBody}</p><a class="button button--primary" href={localizedPath(locale, 'support')}>{c.nav.support}</a></div></section>
<style>
  .faq-hero { background: var(--paper); }
  .faq-section { background: var(--canvas); }
  .faq-list { display: grid; gap: .7rem; }
  details { border: 1px solid var(--line); border-radius: 1rem; background: var(--paper-strong); overflow: clip; }
  summary { min-height: 4.7rem; display: grid; grid-template-columns: 3rem 1fr 2rem; align-items: center; gap: .75rem; padding: .8rem 1rem; cursor: pointer; list-style: none; font-family: var(--font-display); font-size: 1.18rem; font-weight: 760; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--red-500); font-size: .75rem; letter-spacing: .08em; }
  summary i { width: 2rem; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; color: white; background: var(--navy-900); font-style: normal; transition: transform 180ms ease; }
  details[open] summary i { transform: rotate(45deg); background: var(--red-500); }
  details > div { padding: 0 4rem 1.3rem 4.75rem; color: var(--slate); }
  details > div p { margin: 0; }
  .faq-cta { background: var(--paper); }
  .faq-cta h2 { font-size: 2rem; }
  @media (max-width: 36rem) { summary { grid-template-columns: 2rem 1fr 2rem; } details > div { padding-left: 3.75rem; } }
</style>
