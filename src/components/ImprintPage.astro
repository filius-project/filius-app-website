---
import type { Locale } from "../config";
import { legalNoticeReady, site } from "../config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const missing =
  locale === "de"
    ? "Noch einzutragen"
    : locale === "fr"
      ? "À compléter"
      : "To be completed";
const copy = {
  de: {
    eyebrow: "Anbieterkennzeichnung",
    title: "Impressum",
    intro: "Anbieterinformationen für filius.app.",
    warning:
      "Die Kontaktadresse ist aktiv. Bis zur abschließenden rechtlichen Prüfung bleibt diese Anbieterkennzeichnung als Entwurf markiert; die veröffentlichten Angaben müssen mit dem tatsächlichen Betrieb übereinstimmen.",
    provider: "Diensteanbieter gemäß § 5 DDG",
    offerName: "„Filius on iPad“ ist die Bezeichnung dieses Angebots.",
    contact: "Kontakt",
    phone: "Telefon",
    register: "Registereintrag",
    vat: "Umsatzsteuer-Identifikationsnummer",
    dispute: "Verbraucherstreitbeilegung",
    disputeBody:
      "Wir sind weder bereit noch verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.",
  },
  en: {
    eyebrow: "Provider identification",
    title: "Legal notice",
    intro: "Provider information for filius.app.",
    warning:
      "The contact address is active. This legal notice remains marked as a draft until final legal review; the published details must continue to match the actual operation.",
    provider: "Service provider pursuant to section 5 DDG",
    offerName: "“Filius on iPad” is the designation of this offering.",
    contact: "Contact",
    phone: "Phone",
    register: "Register entry",
    vat: "VAT identification number",
    dispute: "Consumer dispute resolution",
    disputeBody:
      "We are neither willing nor obliged to participate in dispute-resolution proceedings before a consumer arbitration board.",
  },
  fr: {
    eyebrow: "Identification de l’éditeur",
    title: "Mentions légales",
    intro: "Informations sur l’éditeur de filius.app.",
    warning:
      "L’adresse de contact est active. Ces mentions restent indiquées comme projet jusqu’à la vérification juridique finale ; les informations publiées doivent continuer à correspondre au fonctionnement réel.",
    provider: "Prestataire de services conformément à l’article 5 du DDG",
    offerName: "« Filius on iPad » est la désignation de cette offre.",
    contact: "Contact",
    phone: "Téléphone",
    register: "Inscription au registre",
    vat: "Numéro d’identification à la TVA",
    dispute: "Règlement des litiges de consommation",
    disputeBody:
      "Nous ne sommes ni disposés ni tenus de participer à une procédure de règlement des litiges devant un organisme de médiation de la consommation.",
  },
}[locale];
---

<section class="page-hero trust-hero">
  <div class="reading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="lede">{copy.intro}</p>
    {
      !legalNoticeReady && (
        <p class="draft-notice" role="status">
          {copy.warning}
        </p>
      )
    }
  </div>
</section>
<section class="section trust-section">
  <div class="reading prose content-card legal-copy">
    <section>
      <h2>{copy.provider}</h2>
      <address>
        <strong>{site.legal.controllerName || missing}</strong><br />
        <span>{site.legal.controllerAddress || missing}</span>
      </address>
      <p>{copy.offerName}</p>
    </section>
    <section>
      <h2>{copy.contact}</h2>
      <p>
        <a href={`mailto:${site.legal.controllerEmail}`}>
          {site.legal.controllerEmail}
        </a>
        {
          site.legal.controllerPhone && (
            <>
              <br />
              {copy.phone}: {site.legal.controllerPhone}
            </>
          )
        }
      </p>
    </section>
    {
      site.legal.registerEntry && (
        <section>
          <h2>{copy.register}</h2>
          <p>{site.legal.registerEntry}</p>
        </section>
      )
    }
    {
      site.legal.vatId && (
        <section>
          <h2>{copy.vat}</h2>
          <p>{site.legal.vatId}</p>
        </section>
      )
    }
    <section>
      <h2>{copy.dispute}</h2>
      <p>{copy.disputeBody}</p>
    </section>
  </div>
</section>
<style>
  .trust-hero {
    background: var(--paper);
  }
  .trust-section {
    padding-top: 0;
    background: var(--paper);
  }
  .legal-copy section:first-child h2 {
    margin-top: 0;
  }
  .legal-copy address {
    padding: 1rem;
    border-left: 0.25rem solid var(--red-500);
    background: var(--paper);
    font-style: normal;
    white-space: pre-line;
  }
</style>
