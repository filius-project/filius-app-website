---
import type { Locale } from "../config";
import {
  formatNewsDate,
  newsCopy,
  newsPostPath,
  type NewsPost,
} from "../lib/news";

interface Props {
  locale: Locale;
  posts: NewsPost[];
}

const { locale, posts } = Astro.props;
const c = newsCopy[locale];
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const archive = posts.filter((post) => post !== featured);
---

<section class="news-hero">
  <div class="shell news-hero__grid">
    <div class="news-hero__copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="lede">{c.intro}</p>
    </div>

    <aside class="signal-panel" aria-labelledby="news-legend-title">
      <div class="signal-panel__topline">
        <span id="news-legend-title">{c.legend.title}</span>
        <span class="signal-panel__live" aria-hidden="true">{c.live}</span>
      </div>
      <ul>
        <li class="signal-panel__item signal-panel__item--development">
          <span class="signal-panel__node" aria-hidden="true"></span>
          <strong>{c.kinds.development}</strong>
          <span>{c.legend.development}</span>
        </li>
        <li class="signal-panel__item signal-panel__item--preview">
          <span class="signal-panel__node" aria-hidden="true"></span>
          <strong>{c.kinds.preview}</strong>
          <span>{c.legend.preview}</span>
        </li>
        <li class="signal-panel__item signal-panel__item--release">
          <span class="signal-panel__node" aria-hidden="true"></span>
          <strong>{c.kinds.release}</strong>
          <span>{c.legend.release}</span>
        </li>
      </ul>
    </aside>
  </div>
</section>

{
  featured && (
    <section class="section news-featured">
      <div class="shell">
        <p class="news-section-label">{c.latest}</p>
        <a
          class={`featured-story featured-story--${featured.data.kind}`}
          href={newsPostPath(locale, featured)}
          data-news-card
        >
          <div class="featured-story__trace" aria-hidden="true">
            <>
              <span />
              <span />
              <span />
            </>
          </div>
          <div class="featured-story__body">
            <div class="story-meta">
              <span class={`story-kind story-kind--${featured.data.kind}`}>
                {c.kinds[featured.data.kind]}
              </span>
              <time datetime={featured.data.publishedAt.toISOString()}>
                {formatNewsDate(featured.data.publishedAt, locale)}
              </time>
              <span>{c.readingTime(featured.data.readingMinutes)}</span>
            </div>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.summary}</p>
            <ul class="topic-list" aria-label={c.topics}>
              {featured.data.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
            <span class="story-link">
              {c.readArticle}
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    </section>
  )
}

<section class="section news-archive">
  <div class="shell">
    <div class="news-archive__heading">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.archive}</h2>
      </div>
      <p>{c.archiveIntro}</p>
    </div>

    <ol class="journal-list">
      {
        archive.map((post, index) => (
          <li>
            <a
              class={`journal-entry journal-entry--${post.data.kind}`}
              href={newsPostPath(locale, post)}
              data-news-card
            >
              <span class="journal-entry__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="journal-entry__content">
                <div class="story-meta">
                  <span class={`story-kind story-kind--${post.data.kind}`}>
                    {c.kinds[post.data.kind]}
                  </span>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatNewsDate(post.data.publishedAt, locale)}
                  </time>
                  <span>{c.readingTime(post.data.readingMinutes)}</span>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
              <span class="journal-entry__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .news-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 10vw, 9rem);
    color: white;
    background:
      linear-gradient(115deg, rgb(227 16 29 / 0.13), transparent 35%),
      var(--navy-950);
  }
  .news-hero::before,
  .news-hero::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }
  .news-hero::before {
    width: 35rem;
    height: 35rem;
    right: -12rem;
    top: -18rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 50%;
    box-shadow:
      0 0 0 5rem rgb(255 255 255 / 0.025),
      0 0 0 10rem rgb(255 255 255 / 0.018);
  }
  .news-hero::after {
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.18) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(90deg, transparent, black 45%, black);
  }
  .news-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }
  .news-hero .eyebrow {
    color: var(--red-400);
  }
  .news-hero h1 {
    max-width: 9ch;
  }
  .news-hero .lede {
    color: rgb(255 255 255 / 0.73);
  }
  .signal-panel {
    position: relative;
    overflow: hidden;
    padding: 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.07);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.24);
    backdrop-filter: blur(14px);
  }
  .signal-panel__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.1rem 0.25rem 0.9rem;
    color: rgb(255 255 255 / 0.58);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .signal-panel__live {
    color: #8ee6bd;
  }
  .signal-panel ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .signal-panel__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(7rem, auto) 1fr;
    gap: 0.8rem;
    align-items: center;
    min-height: 4.4rem;
    padding: 0.75rem 0.9rem;
    border-radius: 0.95rem;
    color: rgb(255 255 255 / 0.66);
    background: rgb(16 23 47 / 0.65);
    font-size: 0.9rem;
  }
  .signal-panel__item strong {
    color: white;
  }
  .signal-panel__node {
    width: 0.72rem;
    height: 0.72rem;
    border: 2px solid currentColor;
    border-radius: 50%;
    box-shadow: 0 0 0 0.35rem rgb(255 255 255 / 0.04);
  }
  .signal-panel__item--development {
    color: #8fc8ff;
  }
  .signal-panel__item--preview {
    color: #ff9ba1;
  }
  .signal-panel__item--release {
    color: #8ee6bd;
  }

  .news-featured {
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .news-section-label {
    margin: 0 0 1rem;
    color: var(--slate);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .featured-story {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 0.36fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    color: inherit;
    background: var(--paper-strong);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .featured-story:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 80px rgb(16 23 47 / 0.16);
  }
  .featured-story__trace {
    position: relative;
    min-height: 26rem;
    background:
      radial-gradient(
        circle at 30% 25%,
        rgb(255 255 255 / 0.16),
        transparent 18%
      ),
      linear-gradient(145deg, var(--navy-800), var(--navy-950));
  }
  .featured-story__trace::before,
  .featured-story__trace::after {
    position: absolute;
    content: "";
  }
  .featured-story__trace::before {
    left: 24%;
    top: 18%;
    width: 52%;
    height: 62%;
    border: 2px solid rgb(255 255 255 / 0.18);
    border-radius: 50%;
    transform: rotate(-18deg);
  }
  .featured-story__trace::after {
    left: 50%;
    top: 18%;
    width: 2px;
    height: 64%;
    background: linear-gradient(var(--red-400), rgb(255 255 255 / 0.12));
    transform: rotate(26deg);
    transform-origin: top;
  }
  .featured-story__trace span {
    position: absolute;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    border: 3px solid white;
    border-radius: 50%;
    background: var(--red-500);
    box-shadow: 0 0 0 0.5rem rgb(227 16 29 / 0.2);
  }
  .featured-story__trace span:nth-child(1) {
    left: 26%;
    top: 20%;
  }
  .featured-story__trace span:nth-child(2) {
    right: 22%;
    top: 46%;
  }
  .featured-story__trace span:nth-child(3) {
    left: 35%;
    bottom: 17%;
  }
  .featured-story__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4.5rem);
  }
  .featured-story h2 {
    max-width: 18ch;
    margin-top: 1.2rem;
    font-size: clamp(2.25rem, 4.8vw, 4.8rem);
  }
  .featured-story p {
    max-width: 48rem;
    margin: 1.2rem 0 0;
    color: var(--slate);
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
  }
  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.9rem;
    align-items: center;
    color: var(--slate);
    font-size: 0.87rem;
    font-weight: 650;
  }
  .story-kind {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.2rem 0.62rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .story-kind--development {
    color: #155b91;
    background: #dceeff;
  }
  .story-kind--preview {
    color: #961e2b;
    background: #ffe1e3;
  }
  .story-kind--release {
    color: #096846;
    background: #d9f5e8;
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .topic-list li {
    padding: 0.25rem 0.62rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--navy-700);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .story-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    margin-top: 2rem;
    color: var(--red-600);
    font-weight: 800;
  }
  .story-link span {
    transition: transform 160ms ease;
  }
  .featured-story:hover .story-link span {
    transform: translateX(0.3rem);
  }

  .news-archive {
    padding-top: clamp(3rem, 6vw, 5rem);
    background: var(--paper);
  }
  .news-archive__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .news-archive__heading > p {
    margin: 0;
    color: var(--slate);
    font-size: 1.12rem;
  }
  .journal-list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .journal-entry {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 4vw, 2.7rem);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      padding-inline 170ms ease,
      background-color 170ms ease;
  }
  .journal-entry:hover {
    padding-inline: 1rem;
    background: var(--paper-strong);
  }
  .journal-entry__index {
    color: #6f695f;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .journal-entry h3 {
    max-width: 27ch;
    margin-top: 0.8rem;
    font-size: clamp(1.7rem, 3vw, 2.65rem);
  }
  .journal-entry p {
    max-width: 48rem;
    margin: 0.7rem 0 0;
    color: var(--slate);
  }
  .journal-entry__arrow {
    color: var(--red-600);
    font-size: 1.7rem;
    transition: transform 170ms ease;
  }
  .journal-entry:hover .journal-entry__arrow {
    transform: translate(0.25rem, -0.25rem);
  }

  @media (max-width: 64rem) {
    .news-hero__grid {
      grid-template-columns: 1fr;
    }
    .signal-panel {
      max-width: 42rem;
    }
    .featured-story {
      grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1fr);
    }
    .news-archive__heading {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 44rem) {
    .signal-panel__item {
      grid-template-columns: auto 1fr;
    }
    .signal-panel__item > span:last-child {
      grid-column: 2;
    }
    .featured-story {
      grid-template-columns: 1fr;
    }
    .featured-story__trace {
      min-height: 12rem;
    }
    .featured-story__body {
      padding: 1.5rem;
    }
    .journal-entry {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }
    .journal-entry__arrow {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-story,
    .story-link span,
    .journal-entry,
    .journal-entry__arrow {
      transition: none;
    }
  }
</style>
