---
import { Image } from "astro:assets";

import actionModeIcon from "../assets/app/action-mode.png";
import laptopIcon from "../assets/app/laptop.png";
import pcIcon from "../assets/app/pc.png";
import rj45Icon from "../assets/app/rj45.png";
import saveIcon from "../assets/app/save.png";
import terminalIcon from "../assets/app/terminal.png";
import emptyProjectScreenshot from "../assets/screenshots/empty-project.png";
import packetViewerScreenshot from "../assets/screenshots/packet-viewer.png";
import runtimeScreenshot from "../assets/screenshots/runtime-device.png";
import type { Locale } from "../config";
import { localizedPath } from "../config";
import { copy } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
const labels = {
  de: {
    step: "Schritt",
    result: "Ergebnis",
    success: "Geschafft",
    before: "Bevor du beginnst",
    topologyAlt: "Ein PC und ein Notebook aus Filius on iPad sind direkt mit einem Kabel verbunden.",
    visualAlt: [
      "Echte App-Aufnahme eines neuen, leeren Projekts mit Werkzeugleiste, Gerätepalette und Arbeitsfläche.",
      "Die originalen PC- und Notebook-Symbole aus der Gerätepalette.",
      "PC und Notebook, verbunden mit dem originalen Kabel-Symbol.",
      "PC und Notebook mit den IPv4-Adressen 192.168.1.10 und 192.168.1.20.",
      "Echte App-Aufnahme des Aktionsmodus und eines geöffneten virtuellen Rechners.",
      "Das originale Kommandozeilen-Symbol mit einem erfolgreichen Ping-Befehl.",
      "Echte App-Aufnahme der Paketansicht neben der Speichern-Schaltfläche.",
    ],
    source: "Originale App-Assets",
    screenshot: "Echte App-Aufnahme",
    emptyCanvas: "Leere Arbeitsfläche",
    palette: "Gerätepalette",
    configured: "Gleiches IPv4-Netz",
    actionMode: "Aktionsmodus",
    packetView: "Paketansicht und Projektdatei",
  },
  en: {
    step: "Step",
    result: "Expected result",
    success: "Success",
    before: "Before you start",
    topologyAlt: "A PC and notebook from Filius on iPad connected directly by a cable.",
    visualAlt: [
      "A real app capture of a new empty project with its toolbar, device palette, and design canvas.",
      "The original PC and notebook icons from the device palette.",
      "A PC and notebook connected with the original cable icon.",
      "A PC and notebook with IPv4 addresses 192.168.1.10 and 192.168.1.20.",
      "A real app capture showing action mode and an open virtual computer.",
      "The original command-line icon with a successful ping command.",
      "A real app capture of packet inspection beside the Save button.",
    ],
    source: "Original app assets",
    screenshot: "Real app capture",
    emptyCanvas: "Empty design canvas",
    palette: "Device palette",
    configured: "Same IPv4 network",
    actionMode: "Action mode",
    packetView: "Packet inspection and project file",
  },
  fr: {
    step: "Étape",
    result: "Résultat",
    success: "Terminé",
    before: "Avant de commencer",
    topologyAlt: "Un PC et un portable de Filius on iPad reliés directement par un câble.",
    visualAlt: [
      "Une vraie capture d’un nouveau projet vide avec sa barre d’outils, sa palette d’appareils et sa zone de conception.",
      "Les icônes PC et portable originales de la palette des appareils.",
      "Un PC et un portable reliés avec l’icône de câble originale.",
      "Un PC et un portable avec les adresses IPv4 192.168.1.10 et 192.168.1.20.",
      "Une vraie capture de l’app montrant le mode action et un ordinateur virtuel ouvert.",
      "L’icône de ligne de commande originale avec une commande ping réussie.",
      "Une vraie capture de l’inspection des paquets à côté du bouton Enregistrer.",
    ],
    source: "Ressources originales de l’app",
    screenshot: "Vraie capture de l’app",
    emptyCanvas: "Zone de conception vide",
    palette: "Palette des appareils",
    configured: "Même réseau IPv4",
    actionMode: "Mode action",
    packetView: "Inspection des paquets et fichier projet",
  },
}[locale];
---

<section class="page-hero quick-hero">
  <div class="shell quick-hero-grid">
    <div>
      <p class="eyebrow">{c.nav.quickstart}</p>
      <h1>{c.quickstart.title}</h1>
      <p class="lede">{c.quickstart.intro}</p>
    </div>
    <div class="mini-topology" role="img" aria-label={labels.topologyAlt}>
      <span class="device-node">
        <Image loading="eager" src={pcIcon} alt="" width={64} height={94} />
        <strong>PC 1</strong>
      </span>
      <span class="cable-route" aria-hidden="true">
        <i></i>
        <b>ping</b>
      </span>
      <span class="device-node">
        <Image loading="eager" src={laptopIcon} alt="" width={84} height={80} />
        <strong>PC 2</strong>
      </span>
    </div>
  </div>
</section>

<section class="section--compact preparation">
  <div class="shell preparation-card">
    <h2>{labels.before}</h2>
    <ul>
      {c.quickstart.before.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<section class="section steps-section">
  <div class="shell steps">
    {
      c.quickstart.steps.map((step, index) => (
        <article class="step" id={`step-${index + 1}`}>
          <div class="step-number">
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>
          <div class="step-copy">
            <p class="eyebrow">
              {labels.step} {index + 1}
            </p>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
            <aside>
              <strong>{labels.result}</strong><span>{step.result}</span>
            </aside>
          </div>
          <figure class={`step-visual visual-${index + 1}`} aria-label={labels.visualAlt[index]}>
            {index === 0 && (
              <div class="screenshot-stage screenshot-stage--empty">
                <span class="media-label">{labels.screenshot}</span>
                <Image
                  src={emptyProjectScreenshot}
                  alt={labels.visualAlt[index]}
                  widths={[520, 760, 1040]}
                  sizes="(max-width: 928px) 85vw, 42vw"
                  loading="eager"
                />
                <strong class="stage-caption">{labels.emptyCanvas}</strong>
              </div>
            )}
            {index === 1 && (
              <>
                <div class="canvas-grid"></div>
                <span class="asset-label">{labels.source}</span>
                <div class="device-palette">
                  <span>
                    <Image loading="eager" src={pcIcon} alt="" width={64} height={94} /><strong>PC</strong>
                  </span>
                  <span>
                    <Image loading="eager" src={laptopIcon} alt="" width={84} height={80} /><strong>Notebook</strong>
                  </span>
                </div>
                <strong class="stage-caption">{labels.palette}</strong>
              </>
            )}
            {index === 2 && (
              <>
                <div class="canvas-grid"></div>
                <div class="topology-pair">
                  <span class="topology-device">
                    <Image loading="eager" src={pcIcon} alt="" width={64} height={94} /><strong>PC 1</strong>
                  </span>
                  <span class="topology-cable">
                    <i></i>
                                <Image loading="eager" class="connector left" src={rj45Icon} alt="" width={32} height={26} />
                    <Image loading="eager" class="connector right" src={rj45Icon} alt="" width={32} height={26} />
                  </span>
                  <span class="topology-device">
                    <Image loading="eager" src={laptopIcon} alt="" width={84} height={80} /><strong>PC 2</strong>
                  </span>
                </div>
              </>
            )}
            {index === 3 && (
              <>
                <div class="canvas-grid"></div>
                <div class="address-pair">
                  <span>
                    <Image loading="eager" src={pcIcon} alt="" width={64} height={94} />
                    <b>192.168.1.10</b><small>/24</small>
                  </span>
                  <i></i>
                  <span>
                    <Image loading="eager" src={laptopIcon} alt="" width={84} height={80} />
                    <b>192.168.1.20</b><small>/24</small>
                  </span>
                </div>
                <strong class="network-badge">{labels.configured}</strong>
              </>
            )}
            {index === 4 && (
              <div class="screenshot-stage">
                <span class="media-label">{labels.screenshot}</span>
                <Image
                  src={runtimeScreenshot}
                  alt={labels.visualAlt[index]}
                  widths={[520, 760, 1040]}
                  sizes="(max-width: 928px) 85vw, 42vw"
                  loading="eager"
                />
                <span class="mode-chip">
                  <Image loading="eager" src={actionModeIcon} alt="" width={50} height={50} />
                  <strong>{labels.actionMode}</strong>
                </span>
              </div>
            )}
            {index === 5 && (
              <>
                <div class="terminal-stage">
                  <div class="terminal-titlebar">
                    <Image loading="eager" src={terminalIcon} alt="" width={64} height={64} />
                    <span>CMD · 192.168.1.10</span>
                  </div>
                  <pre><code>$ ping 192.168.1.20<br />reply from 192.168.1.20 · 1 ms<br />reply from 192.168.1.20 · 1 ms<br /><b>2 packets received · 0% loss</b></code></pre>
                </div>
              </>
            )}
            {index === 6 && (
              <div class="screenshot-stage screenshot-stage--packet">
                <span class="media-label">{labels.screenshot}</span>
                <Image
                  src={packetViewerScreenshot}
                  alt={labels.visualAlt[index]}
                  widths={[520, 760, 1040]}
                  sizes="(max-width: 928px) 85vw, 42vw"
                  loading="eager"
                />
                <span class="save-chip">
                  <Image loading="eager" src={saveIcon} alt="" width={50} height={50} />
                  <strong>.fls</strong>
                </span>
                <strong class="packet-caption">{labels.packetView}</strong>
              </div>
            )}
          </figure>
        </article>
      ))
    }
  </div>
</section>

<section class="section done-section">
  <div class="shell done-card">
    <div>
      <p class="eyebrow">{labels.success}</p>
      <h2>{c.quickstart.doneTitle}</h2>
      <p>{c.quickstart.doneBody}</p>
    </div>
    <a class="button button--secondary" href={localizedPath(locale, "docs")}>
      {c.common.readDocs}<span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .quick-hero {
    color: white;
    background: var(--navy-950);
  }
  .quick-hero .eyebrow {
    color: #ff8991;
  }
  .quick-hero .lede {
    color: rgb(255 255 255 / 0.67);
  }
  .quick-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }
  .mini-topology {
    position: relative;
    min-height: 20rem;
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    align-items: center;
    padding: 2rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: var(--radius-xl);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 2.4rem 2.4rem;
  }
  .device-node {
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.2rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 1.4rem;
    background: rgb(45 56 97 / 0.9);
    box-shadow: 0 18px 32px rgb(0 0 0 / 0.2);
  }
  .device-node img {
    width: auto;
    height: 5.5rem;
    object-fit: contain;
  }
  .cable-route {
    position: relative;
    z-index: 1;
    min-height: 8rem;
    display: grid;
    place-items: center;
  }
  .cable-route i {
    position: absolute;
    right: -0.4rem;
    left: -0.4rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--red-500);
  }
  .cable-route b {
    position: absolute;
    z-index: 3;
    bottom: 0;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    color: var(--navy-950);
    background: #fff4a8;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }
  .preparation {
    background: var(--paper);
  }
  .preparation-card {
    display: grid;
    grid-template-columns: 0.5fr 1.5fr;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: white;
  }
  .preparation-card h2 {
    font-size: 2rem;
  }
  .preparation-card ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .steps-section {
    background: var(--canvas);
  }
  .steps {
    display: grid;
    gap: clamp(3rem, 8vw, 7rem);
  }
  .step {
    display: grid;
    grid-template-columns: 5rem 1fr 1.1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
  }
  .step:nth-child(even) .step-copy {
    order: 3;
  }
  .step:nth-child(even) .step-visual {
    order: 2;
  }
  .step-number {
    align-self: stretch;
    display: flex;
    justify-content: center;
    border-right: 1px solid var(--line);
  }
  .step-number span {
    position: sticky;
    top: 7rem;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    color: white;
    background: var(--navy-900);
    font-family: var(--font-display);
    font-weight: 850;
  }
  .step-copy h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
  }
  .step-copy > p:not(.eyebrow) {
    color: var(--slate);
    font-size: 1.15rem;
  }
  .step-copy aside {
    display: grid;
    gap: 0.25rem;
    padding: 1rem;
    border-left: 0.3rem solid var(--green);
    background: #e9f8f1;
  }
  .step-copy aside strong {
    color: #0d6d4c;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .step-visual {
    position: relative;
    min-height: 22rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-strong);
    box-shadow: var(--shadow-card);
  }
  .canvas-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(27 35 70 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(27 35 70 / 0.07) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem;
  }
  .asset-label,
  .media-label {
    position: absolute;
    z-index: 5;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    color: white;
    background: var(--navy-900);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stage-caption {
    position: absolute;
    z-index: 2;
    right: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.65rem;
    color: var(--navy-900);
    background: #fff4a8;
    font-size: 0.82rem;
  }
  .device-palette {
    position: absolute;
    z-index: 2;
    inset: 4rem 2rem 3.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .device-palette > span {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.9);
  }
  .device-palette img {
    width: auto;
    height: 7rem;
    object-fit: contain;
  }
  .topology-pair,
  .address-pair {
    position: absolute;
    z-index: 2;
    inset: 2rem;
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    align-items: center;
  }
  .topology-device,
  .address-pair > span {
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
  }
  .topology-device img,
  .address-pair img {
    width: auto;
    height: 7rem;
    object-fit: contain;
    filter: drop-shadow(0 10px 12px rgb(16 23 47 / 0.16));
  }
  .topology-cable {
    position: relative;
    min-height: 8rem;
    display: grid;
    place-items: center;
  }
  .topology-cable i,
  .address-pair > i {
    position: absolute;
    right: -0.5rem;
    left: -0.5rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--red-500);
  }
  .connector {
    position: absolute;
    z-index: 3;
    width: 2rem;
  }
  .connector.left {
    left: -0.7rem;
  }
  .connector.right {
    right: -0.7rem;
    transform: rotate(180deg);
  }
  .address-pair > span {
    padding: 1rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.9);
  }
  .address-pair b {
    padding: 0.3rem 0.45rem;
    border-radius: 0.35rem;
    background: #fff4a8;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
  }
  .address-pair small {
    color: var(--slate);
  }
  .network-badge {
    position: absolute;
    z-index: 4;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    color: #075a40;
    background: #dff8ec;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .screenshot-stage {
    position: absolute;
    inset: 0;
    padding: 1rem;
    background: var(--navy-900);
  }
  .screenshot-stage > picture,
  .screenshot-stage > picture img,
  .screenshot-stage > img {
    width: 100%;
    height: 100%;
  }
  .screenshot-stage > picture img,
  .screenshot-stage > img {
    border-radius: 1rem;
    object-fit: cover;
    object-position: center;
  }
  .screenshot-stage--empty > picture img,
  .screenshot-stage--empty > img {
    object-fit: cover;
    object-position: 18% top;
  }
  .screenshot-stage--packet > picture img,
  .screenshot-stage--packet > img {
    object-fit: contain;
    object-position: center;
  }
  .media-label {
    top: 1.8rem;
    left: 1.8rem;
    background: rgb(16 23 47 / 0.9);
    backdrop-filter: blur(10px);
  }
  .mode-chip,
  .save-chip {
    position: absolute;
    z-index: 5;
    right: 1.8rem;
    bottom: 1.8rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 1rem;
    color: var(--navy-950);
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.25);
  }
  .mode-chip img,
  .save-chip img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
  .terminal-stage {
    position: absolute;
    inset: 1.25rem;
    overflow: hidden;
    border: 1px solid #344467;
    border-radius: 1rem;
    color: #b8ffca;
    background: #11131a;
    box-shadow: 0 18px 36px rgb(16 23 47 / 0.25);
  }
  .terminal-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #344467;
    color: white;
    background: #1e2740;
    font-weight: 750;
  }
  .terminal-titlebar img {
    width: 2.8rem;
    height: 2.8rem;
  }
  .terminal-stage pre {
    margin: 0;
    padding: clamp(1rem, 4vw, 2rem);
    overflow: auto;
    font-size: clamp(0.72rem, 1.7vw, 1rem);
    line-height: 2;
    white-space: pre-wrap;
  }
  .terminal-stage b {
    color: #fff4a8;
  }
  .packet-caption {
    position: absolute;
    z-index: 4;
    bottom: 1.8rem;
    left: 1.8rem;
    max-width: 48%;
    padding: 0.5rem 0.7rem;
    border-radius: 0.65rem;
    color: white;
    background: rgb(16 23 47 / 0.88);
    font-size: 0.78rem;
  }
  .done-section {
    color: white;
    background: var(--navy-950);
  }
  .done-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  .done-card .eyebrow {
    color: #ff8991;
  }
  .done-card p {
    color: rgb(255 255 255 / 0.66);
  }
  @media (max-width: 58rem) {
    .quick-hero-grid,
    .preparation-card {
      grid-template-columns: 1fr;
    }
    .step {
      grid-template-columns: 3.5rem 1fr;
    }
    .step-visual {
      grid-column: 2;
      width: min(100%, 44rem);
    }
    .step:nth-child(even) .step-copy,
    .step:nth-child(even) .step-visual {
      order: initial;
    }
  }
  @media (max-width: 38rem) {
    .mini-topology {
      min-height: 17rem;
      grid-template-columns: 1fr 0.8fr 1fr;
      padding: 1rem;
    }
    .device-node {
      padding-inline: 0.4rem;
    }
    .device-node img {
      height: 4.4rem;
    }
    .step {
      grid-template-columns: 1fr;
    }
    .step-number {
      display: none;
    }
    .step-visual {
      grid-column: 1;
      min-height: 19rem;
    }
    .device-palette,
    .topology-pair,
    .address-pair {
      inset-inline: 1rem;
    }
    .topology-device img,
    .address-pair img,
    .device-palette img {
      height: 5.2rem;
    }
    .address-pair b {
      font-size: 0.65rem;
    }
    .packet-caption {
      display: none;
    }
    .done-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
